From 33a0237da8dd3eab870c8de1dafb1b016a84a5d7 Mon Sep 17 00:00:00 2001
From: Olivier Lambert <olivier.lambert@vates.tech>
Date: Thu, 1 Oct 2026 08:05:00 +0200
Subject: [PATCH] tools/libxenstat: expose per-VCPU runstate times

Use XEN_DOMCTL_get_vcpu_runstate to collect the time each VCPU spent
runnable, blocked and offline alongside its running time, and add
accessors:

 - xenstat_vcpu_has_runstate(): 1 if the times below are valid;
 - xenstat_vcpu_runnable_ns(): runnable but not running, i.e. waiting
   for a physical CPU ("steal time");
 - xenstat_vcpu_blocked_ns() and xenstat_vcpu_offline_ns();
 - xenstat_vcpu_running_ns(): running time, from the same snapshot;
 - xenstat_vcpu_runstate_time_ns(): the hypervisor time those times
   run to, or 0 if the hypervisor doesn't report it.

Rates must be computed over differences in xenstat_vcpu_runstate_time_ns(),
not the caller's clock: the caller can be descheduled between the
hypercall and its own clock read, which is exactly when the host is
contended.  xenstat_vcpu_ns() keeps returning running time from
XEN_DOMCTL_getvcpuinfo, read at a slightly different moment; use
xenstat_vcpu_running_ns() next to the other runstate times.

On a hypervisor without the domctl, or when XSM denies it, the first
call fails and the handle stops asking, so the cost there is a single
failed hypercall per handle; has_runstate is then 0 and the accessors
return 0.  Other failures only affect the VCPU concerned.

The domctl is issued with xc_domctl() rather than the new
xc_vcpu_get_runstate() wrapper, so this library keeps working as a
drop-in replacement against the stock XCP-ng libxenctrl, which lacks the
wrapper.  (The upstream version of this patch uses the wrapper.)

New fields are appended to the private structures only, so the existing
ABI is unchanged.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 tools/include/xenstat.h        | 23 ++++++++++
 tools/libs/stat/xenstat.c      | 83 ++++++++++++++++++++++++++++++++++
 tools/libs/stat/xenstat_priv.h |  9 ++++
 3 files changed, 115 insertions(+)

diff --git a/tools/include/xenstat.h b/tools/include/xenstat.h
index e197d649c8..bec0e11447 100644
--- a/tools/include/xenstat.h
+++ b/tools/include/xenstat.h
@@ -149,6 +149,29 @@ xenstat_vbd *xenstat_domain_vbd(xenstat_domain * domain,
 unsigned int xenstat_vcpu_online(xenstat_vcpu * vcpu);
 unsigned long long xenstat_vcpu_ns(xenstat_vcpu * vcpu);
 
+/*
+ * Runstate times of the VCPU (XEN_DOMCTL_get_vcpu_runstate): 1 if the
+ * hypervisor provided them for this VCPU, else 0 and the accessors below
+ * return 0.  Cumulative nanoseconds, like xenstat_vcpu_ns() (running time).
+ */
+unsigned int xenstat_vcpu_has_runstate(xenstat_vcpu * vcpu);
+/* Runnable but not running: waiting for a physical CPU ("steal time") */
+unsigned long long xenstat_vcpu_runnable_ns(xenstat_vcpu * vcpu);
+/* Blocked: idle, waiting for an event */
+unsigned long long xenstat_vcpu_blocked_ns(xenstat_vcpu * vcpu);
+/* Offline: down, or paused by the toolstack or hypervisor */
+unsigned long long xenstat_vcpu_offline_ns(xenstat_vcpu * vcpu);
+/* Running, from the same snapshot as the times above */
+unsigned long long xenstat_vcpu_running_ns(xenstat_vcpu * vcpu);
+/*
+ * Hypervisor system time (ns) the runstate times above run to.  Compute
+ * rates as differences in those times over differences in this one, not
+ * over the caller's clock: the caller can be descheduled between the
+ * hypercall and its own clock read, which is exactly when the host is
+ * contended.  0 if the hypervisor doesn't report it.
+ */
+unsigned long long xenstat_vcpu_runstate_time_ns(xenstat_vcpu * vcpu);
+
 
 /*
  * Network functions - extract information from a xenstat_network
diff --git a/tools/libs/stat/xenstat.c b/tools/libs/stat/xenstat.c
index 60f17fe73f..6bc5d7a647 100644
--- a/tools/libs/stat/xenstat.c
+++ b/tools/libs/stat/xenstat.c
@@ -26,6 +26,7 @@
 #include <unistd.h>
 
 #include "xenstat_priv.h"
+#include <xen/vcpu.h>
 
 /*
  * Data-collection types
@@ -500,6 +501,49 @@ xenstat_vbd *xenstat_domain_vbd(xenstat_domain * domain,
 /*
  * VCPU functions
  */
+/* Collect the runstate times of one VCPU, if the hypervisor provides them */
+static void xenstat_collect_vcpu_runstate(xenstat_handle * handle,
+					  unsigned int domid,
+					  unsigned int vcpu,
+					  xenstat_vcpu * v)
+{
+	/*
+	 * Issued with xc_domctl() rather than xc_vcpu_get_runstate() so that
+	 * this library stays a drop-in replacement on hosts whose libxenctrl
+	 * predates that wrapper.
+	 */
+	struct xen_domctl domctl = {
+		.cmd = XEN_DOMCTL_get_vcpu_runstate,
+		.domain = domid,
+		.u.vcpu_runstate.vcpu = vcpu,
+	};
+	const struct xen_domctl_vcpu_runstate *rs = &domctl.u.vcpu_runstate;
+
+	v->has_runstate = 0;
+	v->runnable_ns = v->blocked_ns = v->offline_ns = 0;
+	v->running_ns = v->runstate_time_ns = 0;
+	if (handle->no_vcpu_runstate)
+		return;
+
+	if (xc_domctl(handle->xc_handle, &domctl) != 0) {
+		/*
+		 * Older hypervisor, or not allowed by XSM: don't ask again.
+		 * Other errors (domain going away) only affect this VCPU.
+		 */
+		if (errno == ENOSYS || errno == EOPNOTSUPP ||
+		    errno == EPERM || errno == EACCES)
+			handle->no_vcpu_runstate = 1;
+		return;
+	}
+
+	v->has_runstate = 1;
+	v->runnable_ns = rs->time[RUNSTATE_runnable];
+	v->blocked_ns = rs->time[RUNSTATE_blocked];
+	v->offline_ns = rs->time[RUNSTATE_offline];
+	v->running_ns = rs->time[RUNSTATE_running];
+	v->runstate_time_ns = rs->sample_time;
+}
+
 /* Collect information about VCPUs */
 static int xenstat_collect_vcpus(xenstat_node * node)
 {
@@ -537,6 +581,9 @@ static int xenstat_collect_vcpus(xenstat_node * node)
 			else {
 				node->domains[i].vcpus[vcpu].online = info.online;
 				node->domains[i].vcpus[vcpu].ns = info.cpu_time;
+				xenstat_collect_vcpu_runstate(node->handle,
+					node->domains[i].id, vcpu,
+					&node->domains[i].vcpus[vcpu]);
 			}
 		}
 	}
@@ -568,6 +615,42 @@ unsigned long long xenstat_vcpu_ns(xenstat_vcpu * vcpu)
 	return vcpu->ns;
 }
 
+/* Whether the runstate times below are valid */
+unsigned int xenstat_vcpu_has_runstate(xenstat_vcpu * vcpu)
+{
+	return vcpu->has_runstate;
+}
+
+/* Get time spent runnable but not running (waiting for a pCPU) */
+unsigned long long xenstat_vcpu_runnable_ns(xenstat_vcpu * vcpu)
+{
+	return vcpu->runnable_ns;
+}
+
+/* Get time spent blocked */
+unsigned long long xenstat_vcpu_blocked_ns(xenstat_vcpu * vcpu)
+{
+	return vcpu->blocked_ns;
+}
+
+/* Get time spent offline */
+unsigned long long xenstat_vcpu_offline_ns(xenstat_vcpu * vcpu)
+{
+	return vcpu->offline_ns;
+}
+
+/* Get time spent running, from the same snapshot */
+unsigned long long xenstat_vcpu_running_ns(xenstat_vcpu * vcpu)
+{
+	return vcpu->running_ns;
+}
+
+/* Get the hypervisor time the runstate times run to */
+unsigned long long xenstat_vcpu_runstate_time_ns(xenstat_vcpu * vcpu)
+{
+	return vcpu->runstate_time_ns;
+}
+
 /*
  * Network functions
  */
diff --git a/tools/libs/stat/xenstat_priv.h b/tools/libs/stat/xenstat_priv.h
index aeeb6fc881..4a71a14e4b 100644
--- a/tools/libs/stat/xenstat_priv.h
+++ b/tools/libs/stat/xenstat_priv.h
@@ -38,6 +38,8 @@ struct xenstat_handle {
 	int page_size;
 	void *priv;
 	char xen_version[VERSION_SIZE]; /* xen version running on this node */
+	/* Appended fields: keep existing layout intact */
+	int no_vcpu_runstate; /* hypervisor lacks XEN_DOMCTL_get_vcpu_runstate */
 };
 
 struct xenstat_node {
@@ -74,6 +76,13 @@ struct xenstat_domain {
 struct xenstat_vcpu {
 	unsigned int online;
 	unsigned long long ns;
+	/* Appended fields: only valid when has_runstate is set */
+	unsigned int has_runstate;
+	unsigned long long runnable_ns;
+	unsigned long long blocked_ns;
+	unsigned long long offline_ns;
+	unsigned long long running_ns;
+	unsigned long long runstate_time_ns;
 };
 
 struct xenstat_network {
-- 
2.55.0

